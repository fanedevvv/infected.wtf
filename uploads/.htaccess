# Blocheaza DOAR executia PHP si fisiere executabile
# Imaginile, videoclipurile, muzica raman accesibile normal

<FilesMatch "\.(php|phtml|phar|php3|php4|php5|php7|shtml|cgi|pl|py|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

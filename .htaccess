Options -Indexes
RewriteEngine On
RewriteBase /

# ── Ascunde informatiile serverului ───────────────────
ServerSignature Off
php_flag expose_php Off

# ── Security & privacy headers ────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
    Header always set X-Permitted-Cross-Domain-Policies "none"

    # X-Frame-Options DOAR pe pagini HTML, nu pe imagini
    # (daca e setat si pe imagini, Discord/WhatsApp nu pot face fetch la og:image)
    <FilesMatch "\.(php|html|htm)$">
        Header always set X-Frame-Options "SAMEORIGIN"
    </FilesMatch>

    Header always unset X-Powered-By
    Header always unset X-Generator
    Header always unset X-AspNet-Version
    Header always set Server "Server"

    # ── Previne caching-ul TUTUROR paginilor in browser/DevTools ─────────────
    Header always set Cache-Control "no-store, no-cache, must-revalidate, private"
    Header always set Pragma "no-cache"
    Header always unset ETag
</IfModule>

# ── Dezactivează ETag (previne cache fingerprinting) ──
FileETag None

# ── Cache pentru imagini (necesar pt crawlere OG) ─────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png       "access plus 7 days"
    ExpiresByType image/jpeg      "access plus 7 days"
    ExpiresByType image/gif       "access plus 7 days"
    ExpiresByType image/webp      "access plus 7 days"
    ExpiresByType image/svg+xml   "access plus 7 days"
</IfModule>

# ── Block direct access to sensitive directories ──────
RewriteRule ^(core|config|views)(\/|$) - [F,L]

# ── Block dot-files (except .htaccess itself) ─────────
RewriteRule (^|/)\. - [F,L]

# ── Serve real files and directories as-is ───────────
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ── Everything else → front controller ───────────────
RewriteRule ^(.*)$ index.php [L,QSA]

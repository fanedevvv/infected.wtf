#!/bin/sh
# Posts a single Discord embed summarizing the whole push (all commits + combined file changes).
# Never blocks the push (always exits 0). Enable with: git config core.hooksPath .githooks

repo_root=$(git rev-parse --show-toplevel)
zero="0000000000000000000000000000000000000000"

while read local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue

  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha"
    diff_base=""
  else
    range="$remote_sha..$local_sha"
    diff_base="$remote_sha"
  fi

  titles=$(git log --reverse --pretty=%s "$range" 2>/dev/null)
  if [ -n "$diff_base" ]; then
    files=$(git diff --name-status --find-renames "$diff_base" "$local_sha" 2>/dev/null)
  else
    files=$(git diff-tree --no-commit-id --name-status -r --find-renames "$local_sha" 2>/dev/null)
  fi

  node "$repo_root/scripts/notify-discord-push.js" "$titles" "$files" || true
done

exit 0

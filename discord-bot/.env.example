# Copy this file to .env and fill in real values. .env is gitignored.

# Discord Developer Portal → Bot → Token
DISCORD_BOT_TOKEN=

# Right-click your server icon (Developer Mode on) → Copy Server ID
DISCORD_GUILD_ID=

# Role IDs — right-click each role in Server Settings → Roles → Copy Role ID
DISCORD_ROLE_INFECTED=
DISCORD_ROLE_PREMIUM=
DISCORD_ROLE_VERIFIED=

# Optional: channel the bot posts ban/unban/kick logs to (right-click channel → Copy Channel ID). Leave empty to disable.
DISCORD_LOG_CHANNEL_ID=

# Must match DISCORD_BOT_API_KEY in /var/www/infected.wtf/config/config.php
API_KEY=

# Port the Express API listens on — must match DISCORD_BOT_URL in config.php (http://127.0.0.1:<PORT>)
PORT=4001

# Same MySQL database as the PHP site (config/config.php → DB_HOST/DB_USER/DB_PASS/DB_NAME)
DB_HOST=localhost
DB_USER=
DB_PASS=
DB_NAME=biolink

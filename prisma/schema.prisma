generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                    Int                  @id @default(autoincrement())
  username              String               @unique(map: "username") @db.VarChar(30)
  email                 String               @db.VarChar(500)
  emailBlindIndex       String?              @map("email_blind_index") @db.VarChar(64)
  password              String               @db.VarChar(255)
  emailVerified         Boolean              @default(false) @map("email_verified")
  cookieConsent         String?              @map("cookie_consent") @db.VarChar(20)
  lastLogin             DateTime?            @map("last_login") @db.DateTime(0)
  loginNotify           Boolean              @default(true) @map("login_notify")
  twoFaEnabled          Boolean              @default(false) @map("two_fa_enabled")
  twoFaSecret           String?              @map("two_fa_secret") @db.VarChar(64)
  switchToken           String?              @map("switch_token") @db.VarChar(64)
  switchTokenExpires    DateTime?            @map("switch_token_expires") @db.DateTime(0)
  isAdmin               Boolean?             @default(false) @map("is_admin")
  isOwner               Boolean?             @default(false) @map("is_owner")
  isMod                 Boolean              @default(false) @map("is_mod")
  isPremium             Boolean?             @default(false) @map("is_premium")
  premiumExpiresAt      DateTime?            @map("premium_expires_at") @db.DateTime(0)
  banned                Boolean?             @default(false)
  banUntil              DateTime?            @map("ban_until") @db.DateTime(0)
  rememberToken         String?              @map("remember_token") @db.VarChar(64)
  tokenExpires          DateTime?            @map("token_expires") @db.DateTime(0)
  tokens                Int?                 @default(0)
  tokensSpent           Int?                 @default(0) @map("tokens_spent")
  referralCode          String?              @unique(map: "referral_code") @map("referral_code") @db.VarChar(20)
  referredBy            String?              @map("referred_by") @db.VarChar(20)
  usernameChangedAt     DateTime?            @map("username_changed_at") @db.DateTime(0)
  leaderboardRegionCode String?              @map("leaderboard_region_code") @db.Char(2)
  leaderboardRegionName String?              @map("leaderboard_region_name") @db.VarChar(80)
  regIpHash             String?              @map("reg_ip_hash") @db.VarChar(64)
  createdAt             DateTime?            @default(now()) @map("created_at") @db.Timestamp(0)
  usdSpent              Decimal              @default(0.00) @map("usd_spent") @db.Decimal(10, 2)
  purchasedBundles      String?              @map("purchased_bundles") @db.LongText
  purchasedThemes       String?              @map("purchased_themes") @db.LongText
  lastDailySpinAt       DateTime?            @map("last_daily_spin_at") @db.DateTime(0)
  actionConfirmations   ActionConfirmation[]
  emailChangePending    EmailChangePending[]
  emailVerifications    EmailVerification[]
  integrations          Integration[]
  linkClicks            LinkClick[]
  loginHistory          LoginHistory[]
  notifications         Notification[]
  likesGiven            ProfileLike[]        @relation("LikesGiven")
  likesReceived         ProfileLike[]        @relation("LikesReceived")
  dislikesGiven         ProfileDislike[]     @relation("DislikesGiven")
  dislikesReceived      ProfileDislike[]     @relation("DislikesReceived")
  profileComments       ProfileComment[]
  commentLikes          ProfileCommentLike[]
  reportsFiled          ProfileReport[]      @relation("ReportsFiled")
  hostedImages          HostedImage[]
  profiles              Profile[]
  redeemCodeUses        RedeemCodeUse[]
  referralsMade         Referral[]           @relation("Referrer")
  referralReceived      Referral?            @relation("Referred")
  socialLinks           SocialLink[]
  themesCreated         Theme[]
  viewsLogAsProfile     ViewsLog[]

  @@index([regIpHash], map: "idx_reg_ip_hash")
  @@index([isMod], map: "idx_users_is_mod")
  @@map("users")
}

model Profile {
  id               Int       @id @default(autoincrement())
  userId           Int       @map("user_id")
  slug             String    @unique(map: "uniq_profile_slug") @db.VarChar(30)
  displayName      String?   @map("display_name") @db.VarChar(100)
  bio              String?   @db.VarChar(300)
  location         String?   @db.VarChar(100)
  job              String?   @db.VarChar(100)
  birthDate        DateTime? @map("birth_date") @db.Date
  avatar           String?   @db.VarChar(300)
  banner           String?   @db.VarChar(300)
  backgroundType   String    @default("particles") @map("background_type") @db.VarChar(20)
  backgroundValue  String?   @default("#050507") @map("background_value") @db.VarChar(500)
  accentColor      String    @default("#39ff14") @map("accent_color") @db.VarChar(7)
  backgroundColor  String    @default("#050507") @map("background_color") @db.VarChar(7)
  nameColor        String    @default("#ffffff") @map("name_color") @db.VarChar(7)
  bioColor         String    @default("#c9c9d1") @map("bio_color") @db.VarChar(7)
  overlayColor     String    @default("#060610") @map("overlay_color") @db.VarChar(7)
  musicTracks      String?   @map("music_tracks") @db.LongText
  playlistStyle    String    @default("glow") @map("playlist_style") @db.VarChar(20)
  layoutTemplate   String    @default("classic") @map("layout_template") @db.VarChar(20)
  cursorPath       String?   @map("cursor_path") @db.VarChar(500)
  cursorTrail      Boolean?  @default(false) @map("cursor_trail")
  particleEffect   Boolean?  @default(false) @map("particle_effect")
  profileFont      String?   @default("Syne") @map("profile_font") @db.VarChar(50)
  profileOpacity   Int?      @default(100) @map("profile_opacity") @db.UnsignedTinyInt
  profileBlur      Int?      @default(0) @map("profile_blur") @db.UnsignedTinyInt
  nameEffect       String    @default("none") @map("name_effect") @db.VarChar(20)
  bioEffect        String    @default("none") @map("bio_effect") @db.VarChar(20)
  views            Int?      @default(0)
  badges           String?   @db.LongText
  badgeHidden      String?   @map("badge_hidden") @db.LongText
  badgeOrder       String?   @map("badge_order") @db.LongText
  avatarShape      String    @default("circle") @map("avatar_shape") @db.VarChar(20)
  avatarRing       String    @default("none") @map("avatar_ring") @db.VarChar(20)
  localViews       Int?      @default(0) @map("local_views")
  purchasedEffects String?   @map("purchased_effects") @db.LongText
  activeEffects    String?   @map("active_effects") @db.LongText
  isPrimary        Boolean   @default(true) @map("is_primary")
  decorationsOwned String?   @map("decorations_owned") @db.LongText
  activeDecoration String?   @map("active_decoration") @db.VarChar(30)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "profiles_ibfk_1")
  viewsLogs        ViewsLog[]
  profileDomains   ProfileDomain[]
  comments         ProfileComment[]
  reports          ProfileReport[]
  projects         ProfileProject[]
  aliases          ProfileAlias[]
  skills           ProfileSkill[]
  bestFriend       ProfileBestFriend?   @relation("BestFriendOwner")
  bestFriendOf     ProfileBestFriend[]  @relation("BestFriendTarget")

  @@index([userId], map: "idx_profile_user")
  @@map("profiles")
}

model SocialLink {
  id           Int    @id @default(autoincrement())
  userId       Int    @map("user_id")
  platform     String @db.VarChar(50)
  url          String @db.VarChar(500)
  displayOrder Int?   @default(0) @map("display_order")
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "social_links_ibfk_1")

  @@index([userId], map: "user_id")
  @@map("social_links")
}

model ViewsLog {
  id            Int      @id @default(autoincrement())
  profileId     Int      @map("profile_id")
  profileUserId Int      @map("profile_user_id")
  ipHash        String   @map("ip_hash") @db.VarChar(64)
  deviceType    String?  @default("desktop") @map("device_type") @db.VarChar(10)
  countryCode   String?  @default("XX") @map("country_code") @db.Char(2)
  countryName   String?  @default("Unknown") @map("country_name") @db.VarChar(80)
  browser       String?  @default("Unknown") @db.VarChar(50)
  osName        String?  @default("Unknown") @map("os_name") @db.VarChar(50)
  viewedAt      DateTime @map("viewed_at") @db.Date
  profile       Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "views_log_profile")
  profileUser   User     @relation(fields: [profileUserId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "views_log_ibfk_1")

  @@unique([profileId, ipHash], map: "unique_view")
  @@map("views_log")
}

model LinkClick {
  id            Int      @id @default(autoincrement())
  profileUserId Int      @map("profile_user_id")
  linkId        Int      @map("link_id")
  linkTitle     String?  @map("link_title") @db.VarChar(200)
  linkUrl       String?  @map("link_url") @db.VarChar(500)
  ipHash        String   @map("ip_hash") @db.VarChar(64)
  clickedAt     DateTime @map("clicked_at") @db.Date
  profileUser   User     @relation(fields: [profileUserId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "link_clicks_ibfk_1")

  @@index([profileUserId], map: "profile_user_id")
  @@map("link_clicks")
}

model ProfileLike {
  id            Int      @id @default(autoincrement())
  profileUserId Int      @map("profile_user_id")
  likerUserId   Int      @map("liker_user_id")
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(0)
  likerUser     User     @relation("LikesGiven", fields: [likerUserId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_pl_liker")
  profileUser   User     @relation("LikesReceived", fields: [profileUserId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_pl_profile")

  @@unique([profileUserId, likerUserId], map: "uniq_profile_liker")
  @@index([likerUserId], map: "fk_pl_liker")
  @@index([profileUserId], map: "idx_profile_user")
  @@map("profile_likes")
}

model DynamicBadge {
  id            Int      @id @default(autoincrement())
  badgeKey      String   @unique(map: "uniq_dynamic_badge_key") @map("badge_key") @db.VarChar(64)
  label         String   @db.VarChar(80)
  color         String?  @db.VarChar(7)
  discordRoleId String?  @unique(map: "uniq_dynamic_badge_role") @map("discord_role_id") @db.VarChar(20)
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(0)

  @@map("dynamic_badges")
}

model SiteDomain {
  id            Int             @id @default(autoincrement())
  hostname      String          @unique(map: "uniq_site_domain_hostname") @db.VarChar(255)
  status        String          @default("pending") @db.VarChar(20) // pending | active | failed
  tier          String          @default("free") @db.VarChar(10) // free | premium
  isDefault     Boolean         @default(false) @map("is_default")
  errorMessage  String?         @map("error_message") @db.VarChar(500)
  addedBy       Int?            @map("added_by")
  verifiedAt    DateTime?       @map("verified_at") @db.DateTime(0)
  createdAt     DateTime        @default(now()) @map("created_at") @db.DateTime(0)
  profileDomains ProfileDomain[]

  @@map("site_domains")
}

model ProfileDomain {
  id        Int        @id @default(autoincrement())
  profileId Int        @map("profile_id")
  domainId  Int        @map("domain_id")
  createdAt DateTime   @default(now()) @map("created_at") @db.DateTime(0)
  profile   Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade, map: "fk_profile_domain_profile")
  domain    SiteDomain @relation(fields: [domainId], references: [id], onDelete: Cascade, map: "fk_profile_domain_domain")

  @@unique([profileId, domainId], map: "uniq_profile_domain")
  @@index([domainId], map: "idx_profile_domain_domain")
  @@map("profile_domains")
}

model Integration {
  id                   Int       @id @default(autoincrement())
  userId               Int       @map("user_id")
  type                 String    @default("discord") @db.VarChar(30)
  discordUserId        String?   @map("discord_user_id") @db.VarChar(25)
  discordUsername      String?   @map("discord_username") @db.VarChar(100)
  discordGlobalName    String?   @map("discord_global_name") @db.VarChar(100)
  discordAvatar        String?   @map("discord_avatar") @db.VarChar(100)
  discordServerInvite  String?   @map("discord_server_invite") @db.VarChar(255)
  discordServerId      String?   @map("discord_server_id") @db.VarChar(30)
  discordServerName    String?   @map("discord_server_name") @db.VarChar(100)
  discordServerIcon    String?   @map("discord_server_icon") @db.VarChar(100)
  discordServerOnline  Int?      @map("discord_server_online")
  discordServerTotal   Int?      @map("discord_server_total")
  discordServerVisible Boolean   @default(true) @map("discord_server_visible")
  discordServerUpdated DateTime? @map("discord_server_updated") @db.DateTime(0)
  data                 String?   @db.LongText
  visible              Boolean?  @default(true)
  createdAt            DateTime? @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt            DateTime? @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "integrations_ibfk_1")

  @@unique([userId, type], map: "uniq_user_type")
  @@map("integrations")
}

model Theme {
  id              Int      @id @default(autoincrement())
  creatorId       Int      @map("creator_id")
  name            String   @db.VarChar(60)
  description     String?  @db.VarChar(300)
  price           Int      @default(100)
  purchaseCount   Int      @default(0) @map("purchase_count")
  publishedAt     DateTime @default(now()) @map("published_at") @db.DateTime(0)
  active          Boolean  @default(true)
  accentColor     String   @map("accent_color") @db.VarChar(7)
  backgroundColor String   @map("background_color") @db.VarChar(7)
  nameColor       String   @map("name_color") @db.VarChar(7)
  bioColor        String   @map("bio_color") @db.VarChar(7)
  overlayColor    String   @map("overlay_color") @db.VarChar(7)
  backgroundType  String   @map("background_type") @db.VarChar(20)
  backgroundValue String   @map("background_value") @db.VarChar(500)
  nameEffect      String   @map("name_effect") @db.VarChar(20)
  bioEffect       String   @map("bio_effect") @db.VarChar(20)
  profileFont     String   @map("profile_font") @db.VarChar(50)
  avatarShape     String   @map("avatar_shape") @db.VarChar(20)
  avatarRing      String   @map("avatar_ring") @db.VarChar(20)
  particleEffect  Boolean  @default(false) @map("particle_effect")
  cursorTrail     Boolean  @default(false) @map("cursor_trail")
  layoutTemplate  String   @default("classic") @map("layout_template") @db.VarChar(20)
  playlistStyle   String   @default("glow") @map("playlist_style") @db.VarChar(20)
  creator         User     @relation(fields: [creatorId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "themes_ibfk_1")

  @@index([creatorId], map: "idx_theme_creator")
  @@index([active], map: "idx_theme_active")
  @@map("themes")
}

model RedeemCode {
  id        Int             @id @default(autoincrement())
  code      String          @unique(map: "code") @db.VarChar(40)
  tokens    Int             @default(0)
  maxUses   Int             @default(1) @map("max_uses")
  usesCount Int             @default(0) @map("uses_count")
  expiresAt DateTime?       @map("expires_at") @db.DateTime(0)
  active    Boolean         @default(true)
  createdAt DateTime        @default(now()) @map("created_at") @db.DateTime(0)
  createdBy Int?            @map("created_by")
  uses      RedeemCodeUse[]

  @@index([code], map: "idx_redeem_code")
  @@map("redeem_codes")
}

model RedeemCodeUse {
  id        Int        @id @default(autoincrement())
  codeId    Int        @map("code_id")
  userId    Int        @map("user_id")
  createdAt DateTime   @default(now()) @map("created_at") @db.DateTime(0)
  code      RedeemCode @relation(fields: [codeId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "redeem_code_uses_ibfk_1")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "redeem_code_uses_ibfk_2")

  @@unique([codeId, userId], map: "uniq_code_user")
  @@index([userId], map: "user_id")
  @@map("redeem_code_uses")
}

model Referral {
  id          Int       @id @default(autoincrement())
  referrerId  Int       @map("referrer_id")
  referredId  Int       @unique(map: "referred_id") @map("referred_id")
  tokensGiven Int?      @default(10) @map("tokens_given")
  createdAt   DateTime? @default(now()) @map("created_at") @db.DateTime(0)
  referrer    User      @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "referrals_ibfk_1")
  referred    User      @relation("Referred", fields: [referredId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "referrals_ibfk_2")

  @@index([referrerId], map: "referrer_id")
  @@map("referrals")
}

model EmailVerification {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  token     String    @unique(map: "token") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.DateTime(0)
  used      Boolean   @default(false)
  usedAt    DateTime? @map("used_at") @db.DateTime(0)
  createdAt DateTime? @default(now()) @map("created_at") @db.DateTime(0)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "email_verifications_ibfk_1")

  @@index([userId], map: "idx_user_id")
  @@index([token], map: "idx_token")
  @@map("email_verifications")
}

model EmailChangePending {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  newEmail  String    @map("new_email") @db.VarChar(255)
  token     String    @unique(map: "token") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.DateTime(0)
  createdAt DateTime? @default(now()) @map("created_at") @db.DateTime(0)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "email_change_pending_ibfk_1")

  @@index([token], map: "idx_token")
  @@index([userId], map: "idx_user_id")
  @@map("email_change_pending")
}

model ActionConfirmation {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  actionType String    @map("action_type") @db.VarChar(50)
  payload    String?   @db.Text
  token      String    @unique(map: "token") @db.VarChar(64)
  expiresAt  DateTime  @map("expires_at") @db.DateTime(0)
  used       Boolean   @default(false)
  usedAt     DateTime? @map("used_at") @db.DateTime(0)
  createdAt  DateTime? @default(now()) @map("created_at") @db.DateTime(0)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "action_confirmations_ibfk_1")

  @@index([userId, actionType], map: "idx_user_action")
  @@index([token], map: "idx_token")
  @@map("action_confirmations")
}

model PasswordReset {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  userId    Int      @unique(map: "uq_user_id") @map("user_id") @db.UnsignedInt
  tokenHash String   @unique(map: "uq_token_hash") @map("token_hash") @db.VarChar(64)
  expiresAt DateTime @map("expires_at") @db.DateTime(0)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)

  @@index([expiresAt], map: "idx_expires_at")
  @@map("password_resets")
}

model LoginHistory {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  ipHash     String    @map("ip_hash") @db.VarChar(64)
  ipDisplay  String?   @map("ip_display") @db.VarChar(20)
  deviceType String?   @default("desktop") @map("device_type") @db.VarChar(10)
  browser    String?   @default("Unknown") @db.VarChar(50)
  loggedAt   DateTime? @default(now()) @map("logged_at") @db.DateTime(0)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "login_history_ibfk_1")

  @@index([userId, ipHash], map: "idx_user_ip")
  @@map("login_history")
}

model SiteSettings {
  id               Int       @id @default(autoincrement())
  whitelistEnabled Boolean   @default(false) @map("whitelist_enabled")
  updatedAt        DateTime? @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  updatedBy        Int?      @map("updated_by")
  x2TokensEnabled  Boolean   @default(false) @map("x2_tokens_enabled")

  @@map("site_settings")
}

model RateLimit {
  id          Int      @id @default(autoincrement())
  type        String   @db.VarChar(32)
  ipHash      String   @map("ip_hash") @db.VarChar(64)
  attemptedAt DateTime @default(now()) @map("attempted_at") @db.DateTime(0)

  @@index([type, ipHash, attemptedAt], map: "idx_rl")
  @@map("rate_limits")
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  type      String    @db.VarChar(50)
  title     String    @db.VarChar(200)
  body      String?   @db.VarChar(500)
  icon      String?   @default("bell") @db.VarChar(50)
  link      String?   @db.VarChar(300)
  isRead    Boolean   @default(false) @map("is_read")
  createdAt DateTime? @default(now()) @map("created_at") @db.DateTime(0)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "notifications_ibfk_1")

  @@index([userId, isRead], map: "idx_user_unread")
  @@map("notifications")
}

model Bundle {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(100)
  price       Decimal   @default(0.00) @db.Decimal(8, 2)
  priceType   String    @default("euro") @map("price_type") @db.VarChar(10)
  badges      String?   @db.LongText
  effects     String?   @db.LongText
  premiumDays Int       @default(0) @map("premium_days")
  createdBy   Int?      @map("created_by")
  createdAt   DateTime? @default(now()) @map("created_at") @db.DateTime(0)

  @@map("bundles")
}

model EmailTemplate {
  id                 Int      @id @default(autoincrement())
  templateKey        String   @unique @map("template_key") @db.VarChar(50)
  subject            String   @db.VarChar(255)
  bodyHtml           String   @map("body_html") @db.LongText
  availableVariables String?  @map("available_variables") @db.LongText
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("email_templates")
}

model ProfileDislike {
  id               Int      @id @default(autoincrement())
  profileUserId    Int      @map("profile_user_id")
  dislikerUserId   Int      @map("disliker_user_id")
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(0)
  dislikerUser     User     @relation("DislikesGiven", fields: [dislikerUserId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_pd_disliker")
  profileUser      User     @relation("DislikesReceived", fields: [profileUserId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_pd_profile")

  @@unique([profileUserId, dislikerUserId], map: "uniq_profile_disliker")
  @@index([dislikerUserId], map: "fk_pd_disliker")
  @@map("profile_dislikes")
}

model ProfileComment {
  id        Int                  @id @default(autoincrement())
  profileId Int                  @map("profile_id")
  authorId  Int                  @map("author_id")
  body      String               @db.VarChar(500)
  likeCount Int                  @default(0) @map("like_count")
  createdAt DateTime             @default(now()) @map("created_at") @db.DateTime(0)
  profile   Profile              @relation(fields: [profileId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_pc_profile")
  author    User                 @relation(fields: [authorId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_pc_author")
  likes     ProfileCommentLike[]

  @@index([profileId, createdAt], map: "idx_pc_profile_created")
  @@index([authorId], map: "fk_pc_author")
  @@map("profile_comments")
}

model ProfileCommentLike {
  id        Int            @id @default(autoincrement())
  commentId Int            @map("comment_id")
  userId    Int            @map("user_id")
  createdAt DateTime       @default(now()) @map("created_at") @db.DateTime(0)
  comment   ProfileComment @relation(fields: [commentId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_pcl_comment")
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_pcl_user")

  @@unique([commentId, userId], map: "uniq_comment_user")
  @@index([userId], map: "fk_pcl_user")
  @@map("profile_comment_likes")
}

model ProfileReport {
  id         Int       @id @default(autoincrement())
  profileId  Int       @map("profile_id")
  reporterId Int?      @map("reporter_id")
  ipHash     String    @map("ip_hash") @db.VarChar(64)
  reason     String    @db.VarChar(30)
  details    String?   @db.VarChar(1000)
  status     String    @default("open") @db.VarChar(20)
  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  resolvedAt DateTime? @map("resolved_at") @db.DateTime(0)
  profile    Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_pr_profile")
  reporter   User?     @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: SetNull, onUpdate: Restrict, map: "fk_pr_reporter")

  @@index([profileId], map: "fk_pr_profile")
  @@index([reporterId], map: "fk_pr_reporter")
  @@index([status, createdAt], map: "idx_pr_status_created")
  @@map("profile_reports")
}

model ProfileProject {
  id           Int       @id @default(autoincrement())
  profileId    Int       @map("profile_id")
  title        String    @db.VarChar(80)
  description  String?   @db.VarChar(1000)
  url          String?   @db.VarChar(300)
  repoUrl      String?   @map("repo_url") @db.VarChar(300)
  technologies String?   @db.VarChar(500)
  image        String?   @db.VarChar(300)
  status       String    @default("pending") @db.VarChar(20)
  rejectReason String?   @map("reject_reason") @db.VarChar(300)
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  reviewedAt   DateTime? @map("reviewed_at") @db.DateTime(0)
  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_pp_profile")

  @@index([profileId, status], map: "idx_pp_profile_status")
  @@index([status, createdAt], map: "idx_pp_status_created")
  @@map("profile_projects")
}

model ProfileAlias {
  id        Int      @id @default(autoincrement())
  profileId Int      @map("profile_id")
  alias     String   @unique(map: "uniq_alias") @db.VarChar(30)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_pa_profile")

  @@index([profileId], map: "fk_pa_profile")
  @@map("profile_aliases")
}

model ProfileBestFriend {
  profileId       Int      @id @map("profile_id")
  friendProfileId Int      @map("friend_profile_id")
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(0)
  profile         Profile  @relation("BestFriendOwner", fields: [profileId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_pbf_profile")
  friend          Profile  @relation("BestFriendTarget", fields: [friendProfileId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_pbf_friend")

  @@index([friendProfileId], map: "fk_pbf_friend")
  @@map("profile_best_friends")
}

model ProfileSkill {
  id           Int      @id @default(autoincrement())
  profileId    Int      @map("profile_id")
  name         String   @db.VarChar(40)
  level        Int      @default(50)
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(0)
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_ps_profile")

  @@index([profileId], map: "fk_ps_profile")
  @@map("profile_skills")
}

model HostedImage {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  key       String   @unique(map: "uniq_hosted_key") @db.VarChar(16)
  path      String   @db.VarChar(200)
  name      String   @db.VarChar(200)
  mime      String   @db.VarChar(40)
  size      Int
  width     Int?
  height    Int?
  views     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_hi_user")

  @@index([userId, createdAt], map: "idx_hi_user_created")
  @@map("hosted_images")
}

model Partner {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(80)
  description  String?  @db.VarChar(500)
  image        String?  @db.VarChar(200)
  url          String   @db.VarChar(300)
  displayOrder Int      @default(0) @map("display_order")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(0)

  @@index([active, displayOrder], map: "idx_partners_active_order")
  @@map("partners")
}
